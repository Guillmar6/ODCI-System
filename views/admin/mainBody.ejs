<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ODCI</title>
    <%- include('../components/heads') %>
</head>
<body>
    <div id="addAccountBackContainer">
        <form id="addAccountContainer">
            <span id="addAccountTitle">Add new account</span>
            <div class="inputContainers">
                <label for="facultyName">Faulty name</label>
                <input name="facultyName" type="text" placeholder="Enter faculty name" required>
            </div>
            <div class="inputContainers">
                <label for="email">Email address</label>
                <input name="email" type="text" placeholder="Enter university email" required>
            </div>
            <div class="inputContainers">
                <label for="password">Password</label>
                <input name="password" type="password" placeholder="Set a password" required>
            </div>
            <div class="inputContainers">
                <label for="department">Department</label>
                <select name="department" id="departmentContainer" required>
                    <option value="">-- Select an option --</option>
                </select>
            </div>
            <div class="inputContainers">
                <label for="role">Role</label>
                <select name="role" id="roleContainer" required>
                    <option value="">-- Select an option --</option>
                    <option value="facultyMember">Faculty member</option>
                    <option value="chairPerson">Chair person</option>
                </select>
            </div>
            <div class="inputContainers">
                <label for="date">Date<small>(Default current date)</small></label>
                <input name="date" type="date">
            </div>
            <div style="width: 100%; padding-top: 10px; padding-bottom: 30px;">
                <span style="font-size: 1.1rem; font-weight: 500 !important; color: #2e2e2e;">All field are required.</span>
            </div>
            <div style="display: flex; flex-direction: row;">
                <a href="#" style="text-decoration: none;"><div class="addAccountBtnConfirmation" id="addAccountCancelBtn">Cancel</div></a>
                <a href="#" style="text-decoration: none;"><button class="addAccountBtnConfirmation" id="addAccountCreateBtn" onclick="sendNewAccount()">Create account</button></a>
            </div>
        </form>
    </div>
    <style>
        #addAccountBackContainer {
            position: fixed;
            display: none;
            width: 100%;
            height: 100vh;
            background-color: #0000004f;
            justify-content: center;
            overflow-y: auto;
            padding: 50px;
        }
        #addAccountContainer {
            display: flex;
            flex-direction: column;
            width: 80vw;
            max-width: 760px;
            min-width: 250px;
            height: fit-content;
            border: 2px solid #d1d1d1;
            border-radius: 10px;
            background-color: #FFFFFF;
            box-shadow: #0000002c 2px 2px 3px 3px;
            padding: 40px;
            margin-bottom: 150px;
        }
        #addAccountTitle {
            font-family: system-ui, -apple-system, sans-serif;
            font-size: 1.8rem;
            font-weight: 600 !important;
            color: #1a1a1a;
        }
        .inputContainers {
            display: flex;
            flex-direction: column;
            margin-bottom: 10px;
            margin-top: 20px;
        }
        .inputContainers>label {
            font-family: system-ui, -apple-system, sans-serif;
            font-size: 1.3rem;
            font-weight: 600 !important;
            color: #424242;
        }
        .inputContainers>input, .inputContainers>select {
            border: 2px solid #b9b9b9;
            border-radius: 8px;
            width: 100%;
            height: 60px;
            padding-left: 20px;
            padding-right: 20px;
            background-color: #e9e9e9;
            color: #161616;
            font-family: system-ui, -apple-system, sans-serif;
            font-size: 1.2rem;
            font-weight: 600 !important;
        }
        .inputContainers>select>option {
            color: #161616;
            font-family: system-ui, -apple-system, sans-serif;
            font-size: 1.2rem;
            font-weight: 600 !important;
        }
        #roleContainer {
            border-radius: 10px;
        }
        .addAccountBtnConfirmation {
            text-decoration: none;
            font-family: system-ui, -apple-system, sans-serif;
            font-size: 1.3rem;
            font-weight: 500 !important;
            border: 2px solid #d1d1d1;
            border-radius: 10px;
            margin-right: 10px;
            padding: 10px;
        }
        #addAccountCancelBtn {
            color: #183F30;
        }
        #addAccountCreateBtn {
            background-color: #183F30;
            color: #FFFFFF;
        }
    </style>
    <%- include('../components/header', { profileName: profileName, role: role}) %>
    <%- include('../components/navigationBarAdmin', { currentNav: currentNav }) %>

    <% if (currentNav == 'dashboard') { %>
        <%- include(currentNav) %>
    <% } else if (currentNav == 'account-management') { %>
        <%- include(currentNav) %>
    <% } %>

    <%- include('../components/footer') %>

    <script>
        const addAccountBackContainer = document.getElementById('addAccountBackContainer');
        function hashChanged() {
            addAccountBackContainer.style.display = "none";
            if(window.location.hash === "#addAccount") {
                addAccountBackContainer.style.display = "flex";
            }
        }
        window.addEventListener("hashchange", hashChanged);
        window.addEventListener("DOMContentLoaded", hashChanged);


        const departmentContainer = document.getElementById('departmentContainer');
        async function getDepartments() {
            try {
                const response = await fetch('/apiAuth/getDepartments');
                if(!response.ok) return console.error('Error fetching departments: ' + response.status);

                const result = await response.json();
                result.departments.forEach(item => {
                    const option = document.createElement('option');
                    option.value = item.department_name;
                    option.textContent = item.department_name;
                    departmentContainer.appendChild(option);
                });
            } catch (err) {
                console.error(err);
            }
        }
        getDepartments();

        const form = document.getElementById('addAccountContainer');
        async function sendNewAccount() {
            const formData = new FormData(form);
            const payload = Object.fromEntries(formData.entries());

            try {
                const response = await fetch('/apiAuth/addNewAccount', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if(!response.ok) return console.error(response.status);

                const result = await response.json();
                console.log('Account created successfully: ', result);
                form.reset();
            } catch (err) {
                console.error(err);
            }
        }
    </script>
</body>
</html>
