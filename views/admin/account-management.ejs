<div id="accountManagementContainer">
    <div id="accountManagementChild">
        <div id="mainContainer">
            <div id="accountManagementTitleContainer">
                <span>Account Management</span>
                <span>Manage university accounts and access roles.</span>
            </div>
            <div id="addNewBtnContainer">
                <a id="addNewAccountBtn" href="#addAccount">+ Add new account</a>
            </div>
        </div>
        <div id="accountListContainer">
            <table>
                <thead>
                    <tr>
                        <th>FACULTY NAME</th>
                        <th>EMAIL ADDRESS</th>
                        <th>PASSWORD</th>
                        <th>DEPARTMENT</th>
                        <th>ROLE</th>
                        <th>JOINED DATE</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody id="accountListBody">
                </tbody>
            </table>
        </div>
    </div>
</div>
<style>
    #accountManagementContainer {
        width: 100%;
        height: fit-content;
        padding: 80px;
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: #8f8f8f #FFFFFF;
    }
    #accountManagementChild {
        min-width: 1000px;
    }
    #mainContainer {
        display: flex;
        flex-direction: row;
    }
    #addNewBtnContainer {
        align-content: center;
    }
    #addNewAccountBtn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        width: 180px;
        height: 45px;
        border-radius: 10px;
        background-color: #183F30;
        color: #e6e6e6;
        cursor: pointer;
        box-shadow: #00000052 2px 2px 3px 3px;
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 1rem;
        font-weight: 400 !important;
    }
    #accountManagementTitleContainer {
        display: flex;
        flex-direction: column;
        width: 500px;
        height: 100px;
        flex: 1
    }
    #accountManagementTitleContainer>span {
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 1rem;
        font-weight: 400 !important;
    }
    #accountManagementTitleContainer>span:first-child {
        font-size: 2.3rem;
        font-weight: 500 !important;
        color: #292929;
    }
    #accountManagementTitleContainer>span:last-child {
        font-size: 1.1rem;
        font-weight: 400 !;
        color: #686868;
    }
    #accountListContainer {
        width: 100%;
    }
    #accountListContainer>table {
        width: 100%;
        border: 2px solid #e9e9e9;
        border-radius: 10px;
        overflow: hidden;
    }
    thead {
        background-color: #e9e9e9;
        padding-left: 10px;
    }
    th, td {
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 1rem;
        font-weight: 500 !important;
        color: #686868;
        text-align: left;
        height: 80px;
        text-align: center;
    }
    #accountListBody>tr>td {
        border-top: 2px solid #d4d4d4;
    }
    #accountListBody>tr>td>button {
        border: 1px solid grey; 
        border-radius: 5px; 
        border-top: transparent; 
        border-bottom: transparent; 
        background-color: white; 
        cursor: pointer;
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 1.1rem;
        font-weight: 600 !important;
    }
    #accountListBody>tr>td>button:first-child {
        color: #183F30;
    }
    #accountListBody>tr>td>button:last-child {
        color: #FF0000;
    }
    @media screen and (max-width: 1110px) {
        #accountManagementContainer {
            padding: 8vw;
        }
    }
</style>
<script>
    async function removeUser(row) {
        if(!confirm('Are you sure you want to remove this user?')) return;
        const data = {
            facultyName: row.faculty_name,
            email: row.email,
            password: row.password,
            department: row.department,
            role: row.role,
            joined_date: row.joined_date
        };
        try {
            const response = await fetch('/apiAuth/removeUser', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });
            if(!response.ok) return console.log('Error removing user: ' + response.status);
            
            alert('Account removed!');
        } catch (err) {
            console.error(err);
        }
    }

    var previousDataGetUsers;
    const accountListBody = document.getElementById('accountListBody');
    async function getUsersList(offset, limit, department = null) {
        try {
            const data = {
                offset: offset,
                limit: limit,
                department: department
            };
            const response = await fetch('/apiAuth/getUsersList', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            if(!response.ok) return console.error('Error fetching users: ' + response.status);

            const result = await response.json();
            if(previousDataGetUsers === JSON.stringify(result)) return;
            previousDataGetUsers = JSON.stringify(result);

            const accountListBody = document.getElementById('accountListBody');
            accountListBody.innerHTML = '';

            result.forEach(row => {
                const tr = document.createElement('tr');
                var deptName;
                switch (row.department) {
                    case 1:
                        deptName = 'ITD'
                        break;
                    case 2:
                        deptName = 'TED'
                        break;
                    case 3:
                        deptName = 'ASD'
                        break;
                    default:
                        break;
                }
                tr.innerHTML = `
                    <td>${row.faculty_name}</td>
                    <td>${row.email}</td>
                    <td>${row.password}</td>
                    <td>${deptName}</td>
                    <td>${row.role}</td>
                    <td>${row.joined_date}</td>
                    <td>
                        <button class="editButton">Edit</button>
                        <button class="removeButton">Remove</button>
                    </td>
                `;
                tr.querySelector('.editButton').addEventListener('click', () => { editUser(row); });
                tr.querySelector('.removeButton').addEventListener('click', () => { removeUser(row); });
                accountListBody.appendChild(tr);
            });
        } catch (err) {
            console.error(err);
        }
    }
    getUsersList(0, 10);
    setInterval(() => {
        getUsersList(0, 10);
    }, 3000);
</script>