<header>
    <img src="/images/cvsu-logo.png" alt="CVSU logo" id="cvsuLogo">
    <div id="headerTitleContainer">
        <span id="headerTitle">ODCI SYSTEM</span>
        <span id="headerMiniTitle">Faculty Asynchronous Activity Tracker</span>
    </div>
    <div style="display: flex; flex: 1; height: 100%;"></div>
    <div></div>
    <div id="verticalLine"></div>
    <div id="profileContainer">
        <span id="profileName"><%= profileName %></span>
        <span id="role"><%= role %></span>
    </div>
    <div id="signOutContainer">
        <button id="signOutBtn" onclick="logout()">Sign out</button>
    </div>
    <div id="menuContainer">
        <button id="menuBtn">
            <hr>
            <hr>
            <hr>
        </button>
    </div>
</header>
<script>
    async function logout() {
        try {
            const response = await fetch('/api/logout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });
            if(!response.ok) return console.error('Logout failed with status: ', response.status);
            window.location.href = '/';
        } catch (err) {
            console.error(err);
        }
    }
</script>
<style>
    header {
        width: 100%;
        height: 120px;
        background-color: #183F30;
        display: flex;
        flex-direction: row;
        align-items: center;
        padding-left: 80px;
        padding-right: 80px;
    }
    #cvsuLogo {
        width: 10vw;
        min-width: 50px;
        min-height: 50px;
        max-width: 80px;
        max-height: 80px;
        margin-right: clamp(1vw, 0.5vw + 1rem, 20px);
    }
    #headerTitleContainer {
        display: flex;
        flex-direction: column;
    }
    #headerTitle {
        color: #E8CE63;
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 1.7rem;
        font-weight: 600 !important;
    }
    #headerMiniTitle {
        color: #e9e9e9;
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 1.2rem;
        font-weight: 300 !important;
    }
    #verticalLine {
        background-color: #e9e9e9;
        width: 1px;
        height: 50px;
        margin-right: 17px;
    }
    #profileContainer {
        display: flex;
        flex-direction: column;
        width: 180px;
    }
    #profileName {
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 1.1rem;
        font-weight: 500 !important;
        color: #e9e9e9;
    }
    #role {
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 1rem;
        font-weight: 300 !important;
        color: #e9e9e9;
    }
    #signOutContainer {
        width: fit-content;
    }
    #signOutBtn {
        border: 1px solid black;
        border-radius: 6px;
        background-color: #183F30;
        color: white;
        width: 80px;
        height: 40px;
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 1rem;
        font-weight: 400 !important;
        cursor: pointer;
        box-shadow: #00000070 2px 2px 2px 2px;
    }
    #menuContainer {
        display: none;
    }
    #menuBtn {
        background-color: transparent;
        width: 40px;
        height: 30px;
        border: 0px solid transparent;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        cursor: pointer;
    }
    #menuBtn>hr {
        width: 100%;
    }
    @media screen and (max-width: 1110px) {
        header {
            padding-left: 10px;
            padding-right: 10px;
        }
    }
    @media screen and (max-width: 608px) {
        #verticalLine {
            display: none;
        }
        #profileContainer {
            display: none;
        }
        #signOutContainer {
            display: none;
        }
        #menuContainer {
            display: flex;
        }
    }
</style>