<div id="navigationBarAdmin">
    <span><a id="dashboard" href="dashboard">Dashboard</a></span>
    <span><a id="reports-analytics" href="reports-analytics">Reports & Analytics</a></span>
    <span><a id="activity-logs" href="activity-logs">Activity Logs</a></span>
    <span><a id="tickets" href="tickets">Tickets</a></span>
    <span><a id="account-management" href="account-management">Account Management</a></span>
</div>
<style>
    #navigationBarAdmin {
        width: 100%;
        min-height: 65px;
        height: fit-content;
        align-content: center;
        padding-left: clamp(10px, 10vw, 190px);
        border-bottom: 1px solid #d6d6d6;
    }
    #navigationBarAdmin>span {
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 1.1rem;
        font-weight: 500 !important;
        color: #999999;
        padding-right: 65px;
        text-wrap-mode: nowrap;
    }
    #navigationBarAdmin>span>a {
        cursor: pointer;
        text-decoration: none;
        color: #999999;
    }
</style>
<script>
    function currentNav(value) {
        const nav = document.getElementById(value);
        nav.style.color = '#183F30';
        nav.style.textDecoration = 'underline';
    }
    currentNav('<%= currentNav %>')
</script>